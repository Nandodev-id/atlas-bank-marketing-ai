# Local Python environment, tooling and secrets
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.coverage
.ipynb_checkpoints/
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# Local dataset files: keep metadata and acquisition instructions in Git
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/DATASET.sha256
/data/processed/

# Never commit runtime artifacts or user-level logs
/artifacts/
/models/
/mlruns/
/outputs/
/logs/
*.joblib
*.pkl
*.sqlite
*.db
/runtime/
/.cache/

# Local-only exam handout and machine/packaging traces (not application source)
/docs/Sujet_Examen_Atlas_IA_Marketing_Bancaire.pdf
/reports/environment_all_packages.json
/reports/delivery_manifest.json
*.log
