# Local Python environment, tooling and secrets
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.coverage
.ipynb_checkpoints/
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# Local dataset files: keep metadata and acquisition instructions in Git
/data/raw/*
!/data/raw/.gitkeep
!/data/raw/DATASET.sha256
/data/processed/

# Never commit runtime artifacts or user-level logs
/artifacts/
/models/
/mlruns/
/outputs/
/logs/
*.joblib
*.pkl
*.sqlite
*.db
